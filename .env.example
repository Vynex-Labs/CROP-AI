# CROP-AI environment — copy to .env and edit. Do not commit secrets.

# Paths (relative to repo root unless absolute)
CROP_AI_ROOT=
CROP_AI_DATA_DIR=data
CROP_AI_RUNS_DIR=runs
CROP_AI_MODELS_DIR=models
CROP_AI_LOGS_DIR=logs

# Dataset
CROP_AI_DATASET_VERSION=v0.1.0-phase1
CROP_AI_ALLOW_SYNTHETIC=1
CROP_AI_SYNTHETIC_ONLY=0

# Training (used from Phase 2 onward)
CROP_AI_DEVICE=auto
CROP_AI_PRECISION=fp16
CROP_AI_SEED=42
CROP_AI_NUM_WORKERS=4
CROP_AI_BATCH_SIZE=16

# Optional API keys for weather/soil adapters (leave empty for offline)
OPEN_METEO_ENABLED=1
NASA_POWER_ENABLED=0
IMD_API_KEY=
SOILGRIDS_ENABLED=0

# Storage
CROP_AI_DB_PATH=data/processed/cropai.sqlite3
