{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropai.local/schemas/image_record.json",
  "title": "CROP-AI image record",
  "type": "object",
  "required": [
    "sample_id",
    "relpath",
    "crop_id",
    "class_id",
    "split",
    "source",
    "is_synthetic",
    "is_field",
    "license",
    "dataset_version"
  ],
  "properties": {
    "sample_id": { "type": "string", "minLength": 1 },
    "relpath": { "type": "string", "minLength": 1 },
    "crop_id": { "type": "string" },
    "class_id": { "type": "string" },
    "task": { "type": "string" },
    "split": { "type": "string", "enum": ["train", "val", "test", "unassigned"] },
    "source": { "type": "string" },
    "license": { "type": "string" },
    "dataset_version": { "type": "string" },
    "is_synthetic": { "type": "boolean" },
    "is_field": { "type": "boolean" },
    "farmer_id": { "type": "string" },
    "location_id": { "type": "string" },
    "video_id": { "type": "string" },
    "capture_session_id": { "type": "string" },
    "source_group": { "type": "string" },
    "width": { "type": ["integer", "null"], "minimum": 1 },
    "height": { "type": ["integer", "null"], "minimum": 1 },
    "sha256": { "type": "string" },
    "captured_at": { "type": "string" },
    "lat": { "type": ["number", "null"] },
    "lon": { "type": ["number", "null"] },
    "h3_index": { "type": "string" },
    "growth_stage": { "type": "string" },
    "variety": { "type": "string" },
    "severity_bin": { "type": "string" },
    "affected_area_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "symptom_region": { "type": "string" },
    "annotation_path": { "type": "string" },
    "notes": { "type": "string" }
  }
}
